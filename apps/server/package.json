{
  "name": "@streamdesk/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "streamdesk-server": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && shx mkdir -p dist/db/migrations && shx cp -r src/db/migrations/. dist/db/migrations",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@streamdesk/shared-types": "workspace:*",
    "@streamdesk/protocol": "workspace:*",
    "@streamdesk/plugin-manifest": "workspace:*",
    "@streamdesk/server-sdk": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^10.0.1",
    "ajv": "^8.17.1",
    "better-sqlite3": "^11.2.1",
    "fastify": "^4.28.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@streamdesk/test-utils": "workspace:*",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "rimraf": "^5.0.5",
    "shx": "^0.3.4",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
